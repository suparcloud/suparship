### CLI

**Unit tests for parsing and validation:**

```go
// internal/cli/preview_test.go
func TestSanitizePreviewName(t *testing.T) {
    tests := []struct {
        input    string
        expected string
    }{
        {"pr-123", "pr-123"},
        {"feature/my-thing", "feature-my-thing"},
        {"PR_123", "pr-123"},
        {"UPPER-CASE", "upper-case"},
        {"with--double--dashes", "with-double-dashes"},
        {"-leading-dash", "leading-dash"},
        {"trailing-dash-", "trailing-dash"},
        {"special!@#chars", "special-chars"},
        {strings.Repeat("a", 100), strings.Repeat("a", 53)}, // Truncation
    }
    
    for _, tt := range tests {
        t.Run(tt.input, func(t *testing.T) {
            result := SanitizePreviewName(tt.input)
            assert.Equal(t, tt.expected, result)
        })
    }
}

func TestParseSecretRef(t *testing.T) {
    tests := []struct {
        input       string
        wantSecret  string
        wantKey     string
        wantErr     bool
    }{
        {"ref:my-secret.key", "my-secret", "key", false},
        {"ref:db-credentials.password", "db-credentials", "password", false},
        {"literal-value", "", "", true},
        {"ref:invalid", "", "", true},
        {"ref:.missing-name", "", "", true},
    }
    
    for _, tt := range tests {
        t.Run(tt.input, func(t *testing.T) {
            secret, key, err := ParseSecretRef(tt.input)
            if tt.wantErr {
                assert.Error(t, err)
                return
            }
            assert.NoError(t, err)
            assert.Equal(t, tt.wantSecret, secret)
            assert.Equal(t, tt.wantKey, key)
        })
    }
}
```

