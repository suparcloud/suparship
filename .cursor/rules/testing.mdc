## Flaky Test Mitigation

### Common Causes & Solutions

| Cause | Solution |
|-------|----------|
| Timing-dependent | Use explicit waits with polling |
| Port conflicts | Use random available ports |
| Cluster state | Clean up before AND after tests |
| Network issues | Retry with backoff |

### Wait Pattern

```go
func waitForCondition(ctx context.Context, check func() bool, interval, timeout time.Duration) error {
    ticker := time.NewTicker(interval)
    defer ticker.Stop()
    
    timeoutCh := time.After(timeout)
    
    for {
        if check() {
            return nil
        }
        
        select {
        case <-ctx.Done():
            return ctx.Err()
        case <-timeoutCh:
            return errors.New("timeout waiting for condition")
        case <-ticker.C:
            continue
        }
    }
}
```

### Retry Pattern

```go
func retry(ctx context.Context, attempts int, delay time.Duration, fn func() error) error {
    var lastErr error
    for i := 0; i < attempts; i++ {
        if err := fn(); err == nil {
            return nil
        } else {
            lastErr = err
            slog.Debug("retry attempt failed", "attempt", i+1, "error", err)
        }
        
        select {
        case <-ctx.Done():
            return ctx.Err()
        case <-time.After(delay):
            delay *= 2 // Exponential backoff
        }
    }
    return fmt.Errorf("all %d attempts failed: %w", attempts, lastErr)
}
```

### Isolation

```go
func TestIsolated(t *testing.T) {
    // Unique namespace per test
    namespace := fmt.Sprintf("test-%s-%d", t.Name(), time.Now().UnixNano())
    
    // Cleanup on both success and failure
    t.Cleanup(func() {
        deleteNamespace(context.Background(), namespace)
    })
    
    // Create isolated resources
    createNamespace(t, namespace)
    // ... test logic
}
```

