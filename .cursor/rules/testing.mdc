## Test Commands

### Local Development

```bash
# Run all unit tests (fast)
make test
# or: go test -short ./...

# Run unit tests with coverage
make test-coverage
# or: go test -short -coverprofile=coverage.out ./...

# Run golden tests (update snapshots)
go test ./internal/renderer/... -update-golden

# Run integration tests (requires kind/k3d)
make test-integration
# or: go test -tags=integration ./test/integration/...

# Run specific test
go test -run TestSanitizePreviewName ./internal/cli/...
```

### CI Commands

```yaml
# .github/workflows/ci.yaml
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
      
      - name: Unit tests
        run: go test -short -race -coverprofile=coverage.out ./...
      
      - name: Golden test verification
        run: |
          go test ./internal/renderer/... -update-golden
          git diff --exit-code testdata/golden/
      
      - name: Upload coverage
        uses: codecov/codecov-action@v4
        with:
          files: coverage.out

  integration:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Create k3d cluster
        uses: AbsaOSS/k3d-action@v2
        with:
          cluster-name: test
      
      - name: Integration tests
        run: go test -tags=integration -timeout=10m ./test/integration/...

  smoke:
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule' || github.ref == 'refs/heads/main'
    steps:
      - uses: actions/checkout@v4
      
      - name: Smoke test
        run: |
          go build -o suparship ./cmd/suparship
          ./suparship demo --yes
          # Verification steps...
```

