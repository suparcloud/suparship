# suparship — local development defaults
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# These values are safe defaults for local development only.
# Do NOT use these in production.

# Development mode: "local" disables real cluster integrations
SUPARSHIP_DEV_MODE=local

# Auth mode: "basic" uses bootstrap admin credentials
SUPARSHIP_AUTH_MODE=basic

# Bootstrap admin credentials (local dev only — never use in production)
SUPARSHIP_ADMIN_EMAIL=admin@local
SUPARSHIP_ADMIN_PASSWORD=admin123

# Backend HTTP listen address
SUPARSHIP_ADDR=:8080

# Frontend Vite dev server port
SUPARSHIP_FRONTEND_PORT=5173

# Cluster mode: "fake" stubs Kubernetes calls for offline development
SUPARSHIP_CLUSTER_MODE=fake

# ── GitOps repo (bootstrap-only, cluster dev mode) ───────────────────────
# These env vars are BOOTSTRAP-ONLY: they seed the GitOps ConfigMap on
# first boot when no ConfigMap exists yet. After that, the ConfigMap
# (managed via settings UI or Helm) is the sole source of truth and
# these env vars are ignored on subsequent restarts.
#
# Only needed when running against a real kind cluster (task dev:cluster).
# Gitea is installed automatically by task dev:cluster.
#
# SUPARSHIP_GITOPS_REPO_URL=http://gitea.localhost:8880/gitops/gitops.git
# SUPARSHIP_GITOPS_REPO_USER=gitops
# SUPARSHIP_GITOPS_REPO_PASSWORD=gitops-dev-only
# SUPARSHIP_ARGOCD_REPO_URL=http://gitea-http.gitea.svc.cluster.local:3000/gitops/gitops.git
