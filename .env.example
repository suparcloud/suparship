# suparship — local development defaults
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# These values are safe defaults for local development only.
# Do NOT use these in production.
#
# SCOPE: the Go binary does NOT read this file. Task loads it (Taskfile.yml
# `dotenv:`) and exports the values into whatever it starts — hack/dev.sh, the
# server process, Vite. So it applies to `task dev` (fake mode) and to a
# host-run binary, and NOT to the in-cluster pod that `task up` deploys: that
# pod's environment comes from charts/suparship. See config/dev/README.md.

# ── Runtime mode ─────────────────────────────────────────────────────────
# Fake mode (no Kubernetes, everything in memory) is triggered by EXACTLY one
# of these two literal values:
#
#   SUPARSHIP_DEV_MODE=local     ← primary switch
#   SUPARSHIP_CLUSTER_MODE=fake  ← explicit override
#
# ANY other value means real-Kubernetes mode. In particular
# SUPARSHIP_CLUSTER_MODE=local reads like "local/offline" but means the
# OPPOSITE — the server will build a real cluster client. See
# internal/config/config.go.
SUPARSHIP_DEV_MODE=local
SUPARSHIP_CLUSTER_MODE=fake

# ── Login credentials ────────────────────────────────────────────────────
# FAKE MODE ONLY. These two are read by internal/fake/adapters.go and are
# ignored entirely once the server talks to a real cluster.
#
#   task dev   (fake mode)     →  admin@local / admin123   (these values)
#   task up    (cluster mode)  →  admin / devpass
#
# In cluster mode credentials come from the Kubernetes Secret
# suparship-system/suparship-admin-auth (username + bcrypt password-hash),
# created by hack/dev/admin-secret.sh — override the password there with
# SUPARSHIP_DEV_PASSWORD. Setting the two vars below has no effect on it.
SUPARSHIP_ADMIN_EMAIL=admin@local
SUPARSHIP_ADMIN_PASSWORD=admin123

# ── Ports ────────────────────────────────────────────────────────────────
# Backend HTTP listen address
SUPARSHIP_ADDR=:8080

# Frontend Vite dev server port (read by hack/dev.sh)
SUPARSHIP_FRONTEND_PORT=5173

# Log the Vite dev-server's /api proxy calls (ui/vite.config.ts). Uncomment to
# debug requests that never reach the backend.
# VITE_DEBUG=true

# ── GitOps repo (bootstrap-only, cluster dev mode) ───────────────────────
# These env vars are BOOTSTRAP-ONLY: they seed the GitOps ConfigMap on
# first boot when no ConfigMap exists yet. After that, the ConfigMap
# (managed via settings UI or Helm) is the sole source of truth and
# these env vars are ignored on subsequent restarts.
#
# Only relevant to a host-run binary pointed at a real cluster. `task up`
# deploys suparship in-cluster and seeds these from charts/suparship instead;
# Gitea itself is installed by the Tiltfile.
#
# SUPARSHIP_GITOPS_REPO_URL=http://gitea.localhost:8880/gitops/gitops.git
# SUPARSHIP_GITOPS_REPO_USER=gitops
# SUPARSHIP_GITOPS_REPO_PASSWORD=gitops-dev-only
# SUPARSHIP_ARGOCD_REPO_URL=http://gitea-http.gitea.svc.cluster.local:3000/gitops/gitops.git
