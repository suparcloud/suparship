{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "kubernetes": {
          "type": "object",
          "required": [
            "qps",
            "burst",
            "authorizationQps",
            "authorizationBurst"
          ],
          "properties": {
            "qps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "burst": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "authorizationQps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "authorizationBurst": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
