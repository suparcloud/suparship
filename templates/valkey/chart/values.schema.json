{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "valkey addon wrapper values",
  "description": "Wrapper-chart shape (AddonInstanceValues) populated by the suparship publisher per addon claim.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "env":  { "type": "string" }
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled":    { "type": "boolean" },
        "type":       { "type": "string" },
        "provider":   { "type": "string" },
        "size":       { "type": "string" },
        "version":    { "type": "string" },
        "secretName": { "type": "string" }
      },
      "required": ["enabled", "type"]
    },
    "suparship": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "envFromConfigMaps": { "type": "array", "items": { "type": "string" } },
        "envFromSecrets":    { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
